   "seed": 1310246553,
   "version": 1,
   "versionNonce": 413711754,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "DB limiter: max 20 connections (Condition)\n  waits on MySQL 1040 / 1203 / 1226\n1205 on batch row -> LOCKED, skipped\nRetries: 408 / 429 / 5xx, back-off <= 120 s\n  Odin submit retried in a new chat\n  upload timeout treated as accepted\nStale claims released after 30 min\nSheetResults JSON: rerun failed sheets only\nProgressPercent 0 -> 100 per file\nIdempotent reruns (clear FileId rows)\nParameterised SQL, tokens redacted\ncontextvars logging + timed_step",
   "originalText": "DB limiter: max 20 connections (Condition)\n  waits on MySQL 1040 / 1203 / 1226\n1205 on batch row -> LOCKED, skipped\nRetries: 408 / 429 / 5xx, back-off <= 120 s\n  Odin submit retried in a new chat\n  upload timeout treated as accepted\nStale claims released after 30 min\nSheetResults JSON: rerun failed sheets only\nProgressPercent 0 -> 100 per file\nIdempotent reruns (clear FileId rows)\nParameterised SQL, tokens redacted\ncontextvars logging + timed_step",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "cc",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 13
  },
