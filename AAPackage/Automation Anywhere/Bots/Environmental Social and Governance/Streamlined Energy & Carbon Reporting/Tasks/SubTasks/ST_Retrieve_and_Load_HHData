rs in cells. Defaults to a space\n            - remove_quotes (bool, optional): Remove literal double quote characters from cell values. Defaults to True\n            \n    Returns:\n        str: Result as a JSON string with status and statistics\n    \"\"\"\n    try:\n        input_file = input_dict.get(\"input_file\")\n        output_file = input_dict.get(\"output_file\")\n        fill_value = input_dict.get(\"fill_value\", \"NA\")\n        newline_replacement = input_dict.get(\"newline_replacement\", \" \")\n        remove_quotes = input_dict.get(\"remove_quotes\", True)\n        file_id = input_dict.get(\"file_id\")\n        \n        if not input_file:\n            raise ValueError(\"input_file parameter is required\")\n        \n        input_path = Path(input_file)\n        if not input_path.exists():\n            raise FileNotFoundError(f\"File not found: {input_file}\")\n        \n        if not output_file:\n            output_file = str(input_path.stem) + \"_filled.csv\"\n        \n        rows_processed = 0\n        blanks_filled = 0\n        newlines_cleaned = 0\n        quotes_cleaned = 0\n        \n        with open(input_file, 'r', encoding='utf-8-sig', newline='') as infile:\n            reader = csv.reader(infile, strict=True)\n            rows = list(reader)\n            \n            for row in rows:\n                for i, cell in enumerate(row):\n                    normalized_cell = re.sub(\n                        r'[^\\S\\r\\n]*\\r\\n|[^\\S\\r\\n]*\\r|[^\\S\\r\\n]*\\n',\n                        lambda match: newline_replacement,\n                        cell\n                    )\n                    if normalized_cell != cell:\n                        newlines_cleaned += len(re.findall(r'\\r\\n|\\r|\\n', cell))\n                        row[i] = normalized_cell\n                    if remove_quotes and '\"' in row[i]:\n                        quote_count = row[i].count('\"')\n                        row[i] = row[i].replace('\"', '')\n                        quotes_cleaned += quote_count\n                    if row[i].strip() == \"\":\n                        row[i] = fill_value\n                        blanks_filled += 1\n                rows_processed += 1\n\n            if rows:\n                rows[0].append(\"FileId\")\n                for row in rows[1:]:\n                    row.append(file_id)\n        \n        with open(output_file, 'w', encoding='utf-8', newline='') as outfile:\n            writer = csv.writer(outfile)\n            writer.writerows(rows)\n        \n        return json.dumps({\n            \"status\": \"success\",\n            \"result\": {\n                \"output_file\": output_file,\n                \"rows_processed\": rows_processed,\n                \"blanks_filled\": blanks_filled,\n                \"fill_value\": fill_value,\n                \"newlines_cleaned\": newlines_cleaned,\n                \"quotes_cleaned\": quotes_cleaned\n            }\n        })\n        \n    except Exception as e:\n        return json.dumps({\n            \"status\": \"error\",\n            \"error\": str(e)\n        })\n\n\nif __name__ == \"__main__\":\n    result = fill_csv_blanks({\n        \"input_file\": \"sample.csv\",\n        \"output_file\": \"sample_filled.csv\",\n        \"fill_value\": \"NA\",\n        \"file_id\": \"12345\"\n    })\n    print(result)"}},{"name":"version","value":{"type":"STRING","string":"3"}},{"name":"pythonInterpreterPath","value":{"type":"STRING","string":""}}],"returnTo":{"type":"SESSION","sessionName":{"type":"STRING","string":"Default"},"sessionTarget":"LOCAL"}},{"uid":"6c5af0cf-e3d1-425a-9df8-9f5249fd21c8","commandName":"assign","packageName":"String","disabled":false,"attributes":[{"name":"sourceString","value":{"type":"STRING","expression":"$sOutputFolderPath$/Cleaned $sCSVFileName$"}}],"returnTo":{"type":"VARIABLE","variableName":"sCSVCleanedFilePath"}},{"uid":"968471f6-c2f4-4dcc-aee9-ab088c998f38","commandName":"assign","packageName":"Dictionary