                            "commandName": "exportToDataTable",
                            "packageName": "Database",
                            "disabled": false,
                            "attributes": [
                                {
                                    "name": "query",
                                    "value": {
                                        "type": "STRING",
                                        "expression": "SELECT FB.BatchId, FB. ReportId, R.ClientId, R.ReportStart, R.ReportEnd, BP.BusinessPartnerName, UF.CategorySelected, UF.FileId, UF.FileName, UF.IsDeleted, UF.IsValid \nFROM $sDatabaseName$.FileUploadBatch FB\nLEFT OUTER JOIN $sDatabaseName$.UploadedFile UF\nON UF.BatchId = FB.BatchId\nLEFT OUTER JOIN $sDatabaseName$.Report R\nON FB.ReportId = R.Id\nLEFT OUTER JOIN $sDatabaseName$.BusinessPartner BP\nON R.ClientId = BP.BusinessPartnerId\nLEFT OUTER JOIN $sDatabaseName$.RefReportType RT\nON R.ReportTypeId = RT.ReportTypeId\nWHERE FB.BatchId = $ioBatchId$ AND UF.IsDeleted = 0 AND UF.IsValid = 1 AND RT.Code = 'SECR' AND UF.FileName = 'Source: Daisy';"
                                    }
                                },
