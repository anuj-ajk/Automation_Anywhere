                                        "string": "SCRIPT"
                                    }
                                },
                                {
                                    "name": "script",
                                    "value": {
                                        "type": "STRING",
                                        "string": "import os\nfrom urllib.parse import urlparse, unquote\n\ndef download_file(dArgs):\n    \"\"\"Download a file from `link` to `outpath`.\n    If `outpath` is None, the filename is inferred from the URL and saved\n    in the current directory. If `outpath` is a directory path, the\n    filename from the URL is appended.\n    Returns the path to the saved file.\n    \"\"\"\n    link = dArgs.get('link')\n    outpath = dArgs.get('output_path')\n    chunk_size = 8192\n\n    if not link:\n        raise ValueError('link is required')\n\n    def filename_from_url(url):\n        p = urlparse(url)\n        fname = os.path.basename(p.path)\n        return unquote(fname) if fname else 'downloaded_file'\n\n    if outpath is None:\n        out_fname = filename_from_url(link)\n        outpath = os.path.join('.', out_fname)\n    else:\n        if os.path.isdir(outpath) or outpath.endswith(os.sep) or outpath.endswith('/'):\n            outpath = os.path.join(outpath, filename_from_url(link))\n\n    base_dir = os.path.dirname(outpath)\n    if base_dir:\n        os.makedirs(base_dir, exist_ok=True)\n\n    try:\n        try:\n            import requests\n            has_requests = True\n        except Exception:\n            has_requests = False\n\n        if has_requests:\n            resp = requests.get(link, stream=True)\n            resp.raise_for_status()\n            with open(outpath, 'wb') as f:\n                for chunk in resp.iter_content(chunk_size=chunk_size):\n                    if chunk:\n                        f.write(chunk)\n        else:\n            import urllib.request\n            urllib.request.urlretrieve(link, outpath)\n\n        return outpath\n    except Exception as e:\n        return f\"Error: with exception{e}\""
                                    }
                                },
