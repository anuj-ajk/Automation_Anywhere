                                    }
                                },
                                {
                                    "name": "script",
                                    "value": {
                                        "type": "STRING",
                                        "string": "import json\nimport os\nfrom openpyxl import load_workbook, Workbook\nfrom openpyxl.utils import get_column_letter\nfrom copy import copy\n\n\ndef split_all_sheets_values_only(input_dict: dict) -> dict:\n    \"\"\"\n    Ultra-fast splitting of all sheets into separate workbooks using values-only mode (O(n) performance).\n    Optimal when formatting is not critical. Fastest execution time.\n    \n    Args:\n        input_dict (dict): Dictionary containing:\n            - source_file (str): Path to source Excel file\n            - output_dir (str): Directory to save output files (default: current directory)\n            - output_prefix (str): Prefix for output files (default: \"sheet_\")\n            \n    Returns:\n        dict: Status with performance metrics for all sheets\n    \"\"\"\n    try:\n        source_file = input_dict.get(\"source_file\")\n        output_dir = input_dict.get(\"output_dir\", \".\")\n        output_prefix = input_dict.get(\"output_prefix\", \"Sheet_\")\n        \n        if not source_file:\n            return json.dumps({\"status\": \"error\", \"error\": \"source_file parameter is required\"}, indent=2)\n        \n        # Ensure output directory exists\n        if output_dir != \".\" and not os.path.exists(output_dir):\n            os.makedirs(output_dir)\n        \n        # Load source workbook\n        source_wb = load_workbook(source_file, data_only=True, keep_links=False)\n        sheet_names = source_wb.sheetnames\n        \n        if not sheet_names:\n            return json.dumps({\"status\": \"error\", \"error\": \"Source workbook contains no sheets\"}, indent=2)\n        \n        results = []\n        \n        for sheet_name in sheet_names:\n            try:\n                if any(keyword in sheet_name.lower() for keyword in (\"instructions\", \"start\", \"lookup\", \"comparison\", \"original\", \"qa action\")):\n                    continue\n                source_sheet = source_wb[sheet_name]\n                \n                # Create new workbook for this sheet\n                target_wb = Workbook()\n                target_sheet = target_wb.active\n                target_sheet.title = sheet_name\n                \n                # Copy data using iter_rows with values_only - optimal O(n) complexity\n                for row in source_sheet.iter_rows(values_only=True):\n                    target_sheet.append(row)\n                \n                # Create safe output file name\n                safe_sheet_name = \"\".join(c for c in sheet_name if c.isalnum() or c in (' ', '_', '-')).rstrip()\n                output_file = os.path.join(output_dir, f\"{output_prefix}{safe_sheet_name}.xlsx\")\n                \n                # Save\n                target_wb.save(output_file)\n                \n                results.append({\n                    \"sheet_name\": sheet_name,\n                    \"file_path\": output_file,\n                    \"status\": \"success\"\n                })\n                \n            except Exception as e:\n                results.append({\n                    \"sheet_name\": sheet_name,\n                    \"status\": \"error\",\n                    \"error\": str(e)\n                })\n        \n        successful = sum(1 for r in results if r[\"status\"] == \"success\")\n        failed = sum(1 for r in results if r[\"status\"] == \"error\")\n        \n        return json.dumps({\n            \"status\": \"success\",\n            \"message\": f\"Successfully split {successful}/{len(sheet_names)} sheets (values only)\",\n            \"successful_sheets\": successful,\n            \"failed_sheets\": failed,\n            \"output_directory\": output_dir,\n            \"created_files\": results\n        }, indent=2)\n        \n    except Exception as e:\n        return json.dumps({\"status\": \"error\", \"error\": str(e)}, indent=2)\n\n\nif __name__ == \"__main__\":\n    # Example: Test all three methods - each splits ALL sheets from source workbook\n    \n    # Values only (fastest)\n    result = split_all_sheets_values_only({\n        \"source_file\": r\"D:\\ESG Client Data Aquisition\\ESG Data\\SECR & ESOS\\DSF (Data Setup Form)\\Inspired ESG_SECR_DSF_(Company Name)_FY(Year).xlsx\",\n        \"output_dir\": r\"D:\\ESG Client Data Aquisition\\Work\\Normalization\\Test Files\\HVAC 2025 B&M UK\",\n        \"output_prefix\": \"Sheet_\"\n    })\n    print(\"Method (Values Only):\")\n    print(result)\n    "
                                    }
