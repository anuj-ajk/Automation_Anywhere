   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Python workflow\n\n- Up to 10 batches processed together\n- All sheets of a file sent to the AI at once\n- Only the failed sheet is retried\n- Finished files are skipped automatically\n- Live % progress for every file\n- Safe on several machines, no double work",
   "originalText": "Python workflow\n\n- Up to 10 batches processed together\n- All sheets of a file sent to the AI at once\n- Only the failed sheet is retried\n- Finished files are skipped automatically\n- Live % progress for every file\n- Safe on several machines, no double work",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "py",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 17
  },
