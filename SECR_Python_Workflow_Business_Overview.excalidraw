   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Automation Anywhere bot\n\n- One batch processed at a time\n- AI answers collected one sheet at a time\n- One failed sheet: whole file runs again\n- Re-running a batch redoes every file\n- Set-up and clean-up steps on every run\n- Progress visible only as a status",
   "originalText": "Automation Anywhere bot\n\n- One batch processed at a time\n- AI answers collected one sheet at a time\n- One failed sheet: whole file runs again\n- Re-running a batch redoes every file\n- Set-up and clean-up steps on every run\n- Progress visible only as a status",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "aa",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 17
  },
